pragma solidity ^0.8.24;

/**
 * @title AuthDomain
 * @notice The canonical cross-language hashing contract for the protocol.
 *
 * @dev Every byte here has a mirror in `packages/protocol-types/src/auth.ts`, and
 *      `contracts/test/cross-language.test.ts` compares the two against vectors
 *      generated by solc. If these definitions ever diverge, every UserOperation
 *      reverts, so the duplication is deliberate and tested rather than avoided.
 */
library AuthDomain {
    /// @dev Must equal `AUTH_DOMAIN` in protocol-types.
    bytes internal constant AUTH_DOMAIN = "HOMOBIO/AUTH-V1";
    bytes internal constant SESSION_DOMAIN = "HOMOBIO/SESSION-V1";
    bytes internal constant RESULT_DOMAIN = "HOMOBIO/RESULT-V1";

    /// @notice keccak256 of the canonical authorization struct.
    function authorizationHash(
        uint8 version,
        address wallet,
        uint64 chainId,
        bytes32 userOpHash,
        bytes16 sessionId,
        bytes32 policyHash,
        uint32 templateVersion,
        uint32 fheKeyVersion,
        bool decision,
        uint32 thresholdBps,
        bytes32 resultCommitment,
        uint64 issuedAt,
        uint64 expiresAt,
        uint32 proofSystem,
        uint32 verifierVersion,
        bytes32 decisionProgramHash
    ) internal pure returns (bytes32) {
        return keccak256(
            abi.encodePacked(
                AUTH_DOMAIN,
                version,
                wallet,
                chainId,
                userOpHash,
                sessionId,
                policyHash,
                templateVersion,
                fheKeyVersion,
                decision,
                thresholdBps,
                resultCommitment,
                issuedAt,
                expiresAt,
                proofSystem,
                verifierVersion,
                decisionProgramHash
            )
        );
    }

    /// @notice keccak256 of the session key's scope.
    function sessionKeyHash(
        address sessionKey,
        address wallet,
        uint64 chainId,
        uint64 validUntil,
        uint256 maxValuePerTx,
        uint32 nonceDomain,
        address[] calldata allowedTargets,
        bytes4[] calldata allowedSelectors
    ) internal pure returns (bytes32) {
        bytes memory targetPart;
        for (uint256 i = 0; i < allowedTargets.length; i++) {
            targetPart = bytes.concat(targetPart, abi.encodePacked(allowedTargets[i]));
        }
        bytes memory selectorPart;
        for (uint256 i = 0; i < allowedSelectors.length; i++) {
            selectorPart = bytes.concat(selectorPart, abi.encodePacked(allowedSelectors[i]));
        }
        return keccak256(
            abi.encodePacked(
                SESSION_DOMAIN,
                sessionKey,
                wallet,
                chainId,
                validUntil,
                maxValuePerTx,
                nonceDomain,
                keccak256(targetPart),
                keccak256(selectorPart)
            )
        );
    }

    /// @notice keccak256 binding the two ciphertexts a decision was derived from.
    function resultCommitment(
        bytes16 sessionId,
        bytes32 templateCommitment,
        bytes32 queryCommitment,
        bool decision
    ) internal pure returns (bytes32) {
        return keccak256(
            abi.encodePacked(RESULT_DOMAIN, sessionId, templateCommitment, queryCommitment, decision)
        );
    }
}

