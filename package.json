{
  "name": "homomorphic-biometric-passkeys",
  "version": "2.0.0",
  "description": "Privacy-preserving biometric authentication + WebAuthn Passkeys + FHE + attestation proofs + ERC-4337 Smart Accounts on Monad",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/build.mjs web",
    "build:services": "node scripts/build.mjs services",
    "compile:contracts": "node scripts/compile-contracts.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:crypto": "vitest run packages/fhe packages/crypto-utils cryptography/vectors",
    "test:contracts": "vitest run contracts/test",
    "validate:manifests": "python infra/k8s/validate.py",
    "dev": "tsx scripts/dev.ts",
    "start": "tsx services/api-gateway/src/main.ts",
    "start:fhe": "tsx services/fhe-service/src/main.ts",
    "vectors": "tsx scripts/gen-vectors.ts",
    "bench": "tsx scripts/bench.ts",
    "demo": "tsx apps/demo/src/main.ts"
  },
  "keywords": [
    "fhe",
    "bgg",
    "rlwe",
    "ckks",
    "webauthn",
    "passkeys",
    "erc-4337",
    "monad",
    "smart-accounts",
    "biometrics"
  ],
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "solc": "^0.8.28",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "viem": "^2.57.4",
    "vitest": "^3.2.4"
  }
}
