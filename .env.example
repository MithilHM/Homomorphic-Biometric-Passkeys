# ---------------------------------------------------------------------------
# Homomorphic Biometric Passkeys — configuration
#
# Copy to `.env` and edit. Every value below has a development default in code,
# so an empty `.env` still boots — but the DEVELOPMENT SECRETS MUST NOT BE USED
# IN PRODUCTION. `docker compose up` will refuse to start if they are unchanged
# and NODE_ENV=production.
# ---------------------------------------------------------------------------

# --------------------------------- runtime ---------------------------------
NODE_ENV=development
LOG_LEVEL=info

# Where the file-backed stores and committee shares live. This directory holds
# the FHE key material and MUST be backed up and access-controlled: losing it
# orphans every enrolled template, and leaking it collapses the threshold.
HOMOBIO_DATA_DIR=./.data

# ---------------------------------- chain ----------------------------------
CHAIN_ID=143
CHAIN_NAME=Monad Testnet
MONAD_RPC=https://testnet-rpc.monad.xyz

# The deployed ERC-4337 EntryPoint for the target network. This is
# configuration, not a constant — confirm it against the exact network version
# before use, because every userOpHash depends on it.
MONAD_ENTRY_POINT=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789

# Deployed contract addresses. Leave blank for a local-only run; the gateway
# reports them as null and refuses to claim an address nothing backs.
ACCOUNT_FACTORY_ADDRESS=
AUTHORIZATION_VERIFIER_ADDRESS=
PROOF_VERIFIER_REGISTRY_ADDRESS=

# -------------------------------- webauthn ---------------------------------
# rpId MUST be a registrable suffix of `origin`. `localhost` is special-cased
# by browsers and works for local development.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Homomorphic Biometric Passkeys
WEBAUTHN_ORIGIN=http://localhost:5000

# Comma-separated CORS allowlist. Keep this tight: it is the browser-side
# boundary, not an authentication control.
ALLOWED_ORIGINS=http://localhost:5000

# ---------------------------------- privy -----------------------------------
# Privy App ID for hardware passkey authentication and cross-device sync.
# Obtain from your Privy dashboard at https://dashboard.privy.io.
# If left empty, the application runs in zero-friction sandbox mode with mock passkeys.
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# ----------------------------------- FHE ------------------------------------
# Error bound advertised by the engine. This widens the `indeterminate` band:
# a comparison landing inside it is refused rather than decided. Measured error
# at the default parameters is ~5e-4 max; 2^-9 (~1.95e-3) is the documented,
# conservative value. Lowering it below the measured error would let a
# near-threshold capture be decided wrongly — do not.
FHE_ERROR_BOUND=0.001953125

# Authentication token for the gateway -> coprocessor channel. The coprocessor
# runs as a separate process precisely so this can be a real boundary.
FHE_SERVICE_TOKEN=dev-fhe-token
FHE_SERVICE_URL=http://127.0.0.1:5001

# Port the coprocessor listens on.
FHE_PORT=5001

# Reuse an existing FHE key set on restart instead of generating a new one.
# Required for any deployment with enrolled templates: a new key set makes every
# existing template ciphertext undecryptable.
# WARNING: rotating the key set invalidates every enrolled template; back up HOMOBIO_DATA_DIR first and plan a re-enrollment.
FHE_REUSE_KEYS=true

# ------------------------------- committee ---------------------------------
# Share 2 of the 3-of-3 decryption committee. The gateway holds share 1; the
# coprocessor holds share 0. No single component can decrypt.
#
# DEVELOPMENT SECRET — replace before any real deployment.
CUSTODY_UNLOCK_SECRET=dev-custody

# If true, the committee is unlocked at boot using CUSTODY_UNLOCK_SECRET.
# Convenient for development; in production prefer an operator calling
# POST /v1/operator/committee/unlock so the secret is not resident in the
# process environment for the lifetime of the service.
CUSTODY_UNLOCK_ON_BOOT=true

# PEM-encoded secp256k1 key the proof service signs authorizations with. Its
# address MUST match the verifier registered in ProofVerifierRegistry, or every
# on-chain authorization reverts with SignatureInvalid. If unset, a keypair is
# generated at boot — fine for development, fatal for production because the
# deployed verifier would not know the address.
PROOF_SERVICE_SECRET_PEM=

# ------------------------------- relayer -----------------------------------
# true (default) logs the UserOperation instead of submitting it.
RELAYER_DRY_RUN=true
BUNDLER_URL=

# -------------------------------- gateway ----------------------------------
PORT=5000
DEFAULT_POLICY_ID=policy-standard-v1
MODEL_VERSION=rp-canonical-v1