# syntax=docker/dockerfile:1
#
# FHE coprocessor. Same build/runtime split as the gateway, but it runs as its
# own image on purpose: it holds one of the three decryption shares and is
# reachable only behind its own service token, so it must be a separable trust
# boundary rather than a module inside the gateway process.

FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json* ./
COPY packages/ ./packages/
COPY services/ ./services/
COPY scripts/ ./scripts/
COPY tsconfig.json ./

RUN npm ci --ignore-scripts
RUN node scripts/build.mjs services


FROM node:22-alpine AS runtime

RUN apk add --no-cache tini

ENV NODE_ENV=production
WORKDIR /app

COPY --from=build /app/dist/services/fhe-service.mjs ./dist/services/fhe-service.mjs

# The coprocessor owns the FHE key set and writes shares 1 and 2 here at
# bootstrap, so this volume must be shared with the gateway.
RUN mkdir -p /app/.data && chown -R node:node /app
USER node

VOLUME ["/app/.data"]
EXPOSE 5001

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/services/fhe-service.mjs"]